<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MediZon" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mz_green</item>
        <item name="colorPrimaryDark">@color/mz_header</item>
        <item name="colorAccent">@color/mz_accent</item>
        <item name="colorControlActivated">@color/mz_accent</item>
        <item name="android:windowBackground">@color/mz_header</item>
        <item name="android:statusBarColor">@color/mz_header</item>
        <item name="android:navigationBarColor">@color/mz_navbar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">@bool/mz_light_nav</item>
    </style>

    <style name="Theme.MediZon.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mz_header</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.MediZon</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/mz_header</item>
        <item name="android:navigationBarColor">@color/mz_header</item>
    </style>

    <style name="Theme.MediZon.Alarm" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/mz_green</item>
        <item name="colorAccent">@color/mz_white</item>
        <item name="android:windowBackground">@drawable/bg_call_gradient</item>
        <item name="android:statusBarColor">@color/mz_header</item>
        <item name="android:navigationBarColor">@color/mz_green</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.MediZon.Settings" parent="Theme.MediZon">
        <item name="android:windowBackground">@color/mz_bg</item>
    </style>
</resources>
